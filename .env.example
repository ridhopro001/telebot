# ==========================================
# TEMPLATE KONFIGURASI BOT
# ==========================================
# Cara pakai:
#   1. Salin file ini menjadi ".env"
#   2. Ganti semua nilai contoh dengan milik kamu
#   3. Jangan commit file ".env" ke Git
#
# Di Windows PowerShell:
#   Copy-Item .env.example .env

# --- Token Bot Telegram ---
# Dapatkan dari @BotFather di Telegram.
TELEGRAM_BOT_TOKEN=isi_token_bot_telegram_kamu

# --- API Key Groq ---
# Dapatkan dari https://console.groq.com/keys
GROQ_API_KEY=isi_api_key_groq_kamu

# ==========================================
# MODEL CHAT (/model)
# ==========================================
# Semua model diatur di sini, bukan di bot.py.
# Format tiap baris:
#   CHAT_MODEL_<nomor>=key|provider|nama_model|label|catatan
#
#   key        : nama pendek untuk /model (huruf/angka/_/-, tanpa spasi)
#   provider   : groq  = cloud Groq
#                local = Ollama lokal (offline)
#   nama_model : harus sama persis dengan nama di Groq / hasil `ollama list`
#   label      : teks tombol (opsional)
#   catatan    : keterangan singkat (opsional)
#
# Menambah model lokal lain cukup tambah satu baris dengan nama model dari
# `ollama list`. Contoh:
#   CHAT_MODEL_4=qwen|local|qwen2.5:3b|Qwen2.5 3B|lokal offline
CHAT_MODEL_1=gpt|groq|openai/gpt-oss-120b|GPT-OSS 120B|cloud Groq
CHAT_MODEL_2=gpt20|groq|openai/gpt-oss-20b|GPT-OSS 20B|cloud cepat
CHAT_MODEL_3=phi4|local|phi4-mini-q4:latest|Phi-4-mini|lokal offline

# Model yang dipakai saat bot start (harus salah satu key di atas).
CHAT_MODEL_DEFAULT=gpt

# --- Model Vision (gambar), terpisah dari model chat ---
# Dipakai untuk membaca gambar/foto/scan (Qwen2.5-VL-3B).
# Pastikan aplikasi Ollama berjalan, lalu daftarkan modelnya:
#   ollama create qwen25vl:3b-local -f Modelfile
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen25vl:3b-local

# --- Cadangan bila semua baris CHAT_MODEL_<n> di atas dihapus ---
# Bot memakai nilai ini dalam urutan: GROQ_MODEL, GROQ_MODEL_70B,
# lalu OLLAMA_CHAT_MODEL.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_70B=llama-3.3-70b-versatile
OLLAMA_CHAT_MODEL=phi4-mini-q4:latest

# --- Keamanan: WAJIB DIISI ---
# Hanya User ID di bawah ini yang boleh memakai bot.
# Cara mendapatkan User ID:
#   - Jalankan bot, lalu kirim /id ke bot kamu, ATAU
#   - Kirim pesan ke @userinfobot di Telegram
#
# Ganti dengan ID kamu. Untuk beberapa orang,
# pisahkan dengan koma tanpa spasi, contoh:
#   TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
#
# JANGAN biarkan angka contoh di atas. Baris di bawah sengaja
# dikosongkan agar tidak ada ID orang lain yang ikut diizinkan.
#
# Jika baris ini kosong atau bukan angka, bot berjalan dalam
# MODE SETUP: semua permintaan ditolak kecuali /id.
TELEGRAM_ALLOWED_USER_IDS=
